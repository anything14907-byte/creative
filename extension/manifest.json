{
  "manifest_version": 3,
  "name": "PyqRanker: University PYQ Matcher & Study Companion",
  "version": "1.0.0",
  "description": "Smart In-Page PYQ Matcher, TF-IDF Syllabus Scanner & Active Recall Rubric Grader for Computer Science Exams.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PyqRanker Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["data/pyqData.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle_pyq_sidebar": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Toggle PyqRanker In-Page Study Sidebar"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "styles.css", "data/pyqData.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
